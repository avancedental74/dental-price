{
  "name": "dental-price",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite",
    "sync:data": "tsx scripts/sync-public-data.ts",
    "build": "npm run sync:data && tsc -b && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "validate:data": "tsx scripts/validate-data.ts",
    "refresh": "tsx scripts/refresh-prices.ts",
    "health": "tsx scripts/connector-health.ts"
  },
  "dependencies": {
    "cheerio": "1.2.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "zod": "3.24.2"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.10.2",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "@vitejs/plugin-react": "4.3.4",
    "eslint": "10.10.0",
    "tsx": "4.19.2",
    "typescript": "5.7.2",
    "typescript-eslint": "8.70.0",
    "vite": "6.4.2",
    "vitest": "2.1.9"
  }
}